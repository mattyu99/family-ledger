{
  "name": "family-ledger",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "deploy:web": "expo export -p web && touch dist/.nojekyll && cp dist/index.html dist/404.html && gh-pages -d dist --dotfiles",
    "build:android": "npx eas-cli@latest build -p android --profile preview",
    "update:android": "CI=1 npx eas-cli@latest update --channel preview --environment preview"
  },
  "private": true
}
