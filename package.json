{
  "name": "family-ledger",
  "version": "1.0.10",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-image-picker": "~57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-quick-actions": "^6.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "gh-pages": "^6.3.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "deploy:web": "expo export -p web && (cp -r public/* dist/ 2>/dev/null || true) && touch dist/.nojekyll && cp dist/index.html dist/404.html && gh-pages -d dist --dotfiles",
    "build:android": "npx eas-cli@latest build -p android --profile preview",
    "update:android": "CI=1 npx eas-cli@latest update --channel preview --environment preview",
    "report:daily": "node scripts/daily-report.mjs",
    "lint": "expo lint",
    "test": "jest",
    "test:unit": "jest src/lib/__tests__",
    "test:rpc": "node scripts/test-database-rpc.mjs",
    "test:all": "npm run test:unit && npm run test:rpc"
  },
  "private": true
}
