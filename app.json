{
  "expo": {
    "name": "甜心記帳本",
    "slug": "family-ledger",
    "scheme": "familyledger",
    "version": "1.0.9",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c85782b1-d64f-4182-a947-5d8363892f4c"
    },
    "experiments": {
      "baseUrl": "/family-ledger"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattyu.familyledger",
      "infoPlist": {
        "NSCameraUsageDescription": "允許使用相機掃描台灣電子發票 QR Code",
        "NSPhotoLibraryUsageDescription": "允許選取發票截圖進行辨識",
        "NSFaceIDUsageDescription": "允許使用 Face ID 驗證身分以保護家庭資產與存款隱私"
      }
    },
    "android": {
      "package": "com.mattyu.familyledger",
      "versionCode": 3,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允許使用相機掃描台灣電子發票 QR Code"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許選取發票截圖進行辨識"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F43F5E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允許使用 Face ID 驗證身分以保護家庭資產與存款隱私"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_expense": {
              "foregroundImage": "./assets/shortcuts/shortcut_expense.png",
              "backgroundColor": "#FFF0F5"
            },
            "shortcut_income": {
              "foregroundImage": "./assets/shortcuts/shortcut_income.png",
              "backgroundColor": "#FFF0F5"
            },
            "shortcut_scan": {
              "foregroundImage": "./assets/shortcuts/shortcut_scan.png",
              "backgroundColor": "#FFF0F5"
            },
            "shortcut_memo": {
              "foregroundImage": "./assets/shortcuts/shortcut_memo.png",
              "backgroundColor": "#FFF0F5"
            }
          },
          "iosIcons": {
            "shortcut_expense": "./assets/shortcuts/shortcut_expense.png",
            "shortcut_income": "./assets/shortcuts/shortcut_income.png",
            "shortcut_scan": "./assets/shortcuts/shortcut_scan.png",
            "shortcut_memo": "./assets/shortcuts/shortcut_memo.png"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c85782b1-d64f-4182-a947-5d8363892f4c"
      }
    }
  }
}
