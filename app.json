{
  "expo": {
    "name": "甜心記帳本",
    "slug": "family-ledger",
    "scheme": "familyledger",
    "version": "1.0.7",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c85782b1-d64f-4182-a947-5d8363892f4c"
    },
    "experiments": {
      "baseUrl": "/family-ledger"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattyu.familyledger",
      "infoPlist": {
        "NSCameraUsageDescription": "允許使用相機掃描台灣電子發票 QR Code",
        "NSPhotoLibraryUsageDescription": "允許選取發票截圖進行辨識"
      }
    },
    "android": {
      "package": "com.mattyu.familyledger",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允許使用相機掃描台灣電子發票 QR Code"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許選取發票截圖進行辨識"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c85782b1-d64f-4182-a947-5d8363892f4c"
      }
    }
  }
}
